NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000
DATABASE_URL=postgresql://arena:change-me-local-only@localhost:5433/arena?schema=public
REDIS_URL=redis://localhost:6380

# Sessions: duration in seconds; default is 7 days.
SESSION_TTL=604800
SESSION_COOKIE_NAME=arena_session
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
# Production: COOKIE_SECURE=true, SESSION_COOKIE_NAME=__Host-arena_session.
# Set to exact trusted reverse-proxy hop count when deployed; never blindly trust forwarding headers.
TRUST_PROXY_HOPS=0
# Dedicated disposable database; never use DATABASE_URL here.
TEST_DATABASE_URL=postgresql://arena:change-me-local-only@localhost:5433/arena_test

# Isolated Redis test database; tests use random keys and never FLUSHDB.
TEST_REDIS_URL=redis://localhost:6380/15

# Authoritative simulation ticks per second (10–60). Snapshots target 10 Hz.
GAME_TICK_RATE=20
