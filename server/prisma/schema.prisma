generator client {
  provider = "prisma-client"
  output = "../src/generated/prisma"
  importFileExtension = "js"
}
datasource db {
  provider = "postgresql"
}
model User {
  id String @id @default(uuid()) @db.Uuid
  email String @unique @db.VarChar(254)
  passwordHash String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  profile PlayerProfile?
  sessions Session[]
}
model PlayerProfile {
  statistics PlayerStatistics?
  @@index([rating, id])
  rating Int @default(1000)
  matchParticipations MatchParticipant[]
  wonMatches Match[] @relation("MatchWinner")
  id String @id @default(uuid()) @db.Uuid
  userId String @unique @db.Uuid
  username String @unique @db.VarChar(20)
  displayName String @db.VarChar(40)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
model Session {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  tokenHash String @unique @db.Char(64)
  expiresAt DateTime
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@index([expiresAt])
}
enum MatchStatus {
  IN_GAME
  FINISHED
}
enum RoomType {
  MANUAL
  MATCHMAKING
}
model Match {
  roomType RoomType @default(MANUAL)
  id String @id @db.Uuid
  roomId String @db.Uuid
  roomName String @db.VarChar(48)
  status MatchStatus @default(IN_GAME)
  startedAt DateTime
  endedAt DateTime?
  durationLimitSeconds Int
  durationSeconds Int?
  endReason String? @db.VarChar(20)
  winnerPlayerProfileId String? @db.Uuid
  winner PlayerProfile? @relation("MatchWinner", fields: [winnerPlayerProfileId], references: [id], onDelete: SetNull)
  participants MatchParticipant[]
  createdAt DateTime @default(now())
  @@index([status, endedAt])
}
model MatchParticipant {
  ratingBefore Int?
  ratingAfter Int?
  ratingDelta Int?
  id String @id @default(uuid()) @db.Uuid
  matchId String @db.Uuid
  participantKey String @db.Uuid
  playerProfileId String? @db.Uuid
  username String @db.VarChar(20)
  displayName String @db.VarChar(40)
  score Int @default(0)
  eliminations Int @default(0)
  deaths Int @default(0)
  placement Int?
  isWinner Boolean @default(false)
  leftEarly Boolean @default(false)
  createdAt DateTime @default(now())
  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
  player PlayerProfile? @relation(fields: [playerProfileId], references: [id], onDelete: SetNull)
  @@unique([matchId, participantKey])
  @@index([playerProfileId, matchId])
}

model PlayerStatistics {
  playerProfileId String @id @db.Uuid
  player PlayerProfile @relation(fields: [playerProfileId], references: [id], onDelete: Cascade)
  totalMatches Int @default(0)
  ratedMatches Int @default(0)
  unratedMatches Int @default(0)
  wins Int @default(0)
  losses Int @default(0)
  ties Int @default(0)
  eliminations Int @default(0)
  deaths Int @default(0)
  ratedWins Int @default(0)
  ratedLosses Int @default(0)
  ratedTies Int @default(0)
  ratedEliminations Int @default(0)
  ratedDeaths Int @default(0)
  currentWinStreak Int @default(0)
  bestWinStreak Int @default(0)
  peakMmr Int @default(1000)
  updatedAt DateTime @updatedAt
  @@index([ratedMatches])
}
